# LLM Provider: openai | deepseek | qwen
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen (OpenAI Compatible)
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 请求超时（秒）
LLM_TIMEOUT=60

# 模型离线加载（本地已有缓存时设为 true，避免连 huggingface.co 超时）
FINANCIAL_POC_HF_OFFLINE=true

# 跳过每次启动时的 AkShare 股票列表同步（已有 stock_registry.json 时可关闭）
FINANCIAL_POC_ENABLE_AKSHARE_STOCK_SYNC=false
