# Financial PoC 环境变量模板
# 复制为 .env 后填写（不要把填好的 .env 提交到 Git）:
#   copy .env.example .env
#
# 运行时请在 .env 文件中配置你的 API Key。
# 代码中一律通过 os.getenv / config.py 读取，禁止硬编码密钥。

# —— 规则分析即可，无需 Key ——
FINANCIAL_POC_AGENT_ENABLE_LLM=false
FINANCIAL_POC_LOG_LEVEL=INFO

# —— 可选：Cursor 自然语言解读 ——
# https://cursor.com/dashboard → API Keys
CURSOR_API_KEY=
FINANCIAL_POC_CURSOR_NARRATIVE=true
FINANCIAL_POC_CURSOR_MODEL=composer-2.5

# —— 可选：LLM 问答（任选一家，并设置 LLM_PROVIDER）——
LLM_PROVIDER=deepseek
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# —— 可选：Tushare ——
TUSHARE_TOKEN=
FINANCIAL_POC_ENABLE_TUSHARE_STOCK_SYNC=false

# —— 可选：监控列表（逗号分隔代码）——
# FINANCIAL_POC_AGENT_WATCHLIST=600519.SH,600036.SH,601318.SH
